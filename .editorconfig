# 统一编辑器行为（覆盖 VS Code / JetBrains / Vim 等）
# 说明：本项目沿用上游 HTML5 UP 模板的 Tab 缩进，故 JS/HTML/CSS 均为 tab。
#       这是「项目既有约定优先」的刻意选择，不是遗漏；详见 README「代码规范」一节。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{html,css,scss,js,mjs,json,yml,yaml}]
indent_style = tab
indent_size = 4

[*.md]
# Markdown 需要行尾两个空格表示换行，故不裁剪
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
